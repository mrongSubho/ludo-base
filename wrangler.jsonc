{
  "$schema":   "node_modules/wrangler/config-schema.json",
  "main":   "src/worker.ts",
  "name":   "ludo-base",
  "compatibility_date":   "2025-01-01",
  "compatibility_flags":   [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets":   {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services":   [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ludo-base"
    }
  ],
  "durable_objects":   {
    "bindings": [
      {
        "name": "MATCH_ROOM",
        "class_name": "MatchRoom"
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimitDO"
      }
    ]
  },
  "migrations":   [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MatchRoom",
        "RateLimitDO"
      ]
    }
  ],
  "triggers":   {
    "crons": [
      "0 * * * *"
    ]
  },
  // A2 (server-authority plan §5-P1): native Cloudflare Rate Limiting bindings —
  // the distributed layer of defense. The in-process Map in `lib/rateLimit.ts`
  // counts per isolate, so the effective limit was `limit x instances`; these
  // bindings count globally (eventually-consistent edge counter) and close that
  // gap for the MUTATION routes. Reads stay in-process by design.
  //
  // Simple mode only (fixed limit/period per binding), so there is one binding
  // per distinct mutation limit in `lib/rateLimitRoutes.ts` RATE_LIMITS —
  // `NATIVE_BINDING_FOR_LIMIT` there maps a rule's limit to its binding name.
  // All matrix windows are 60s, matching `period: 60`.
  //
  // `lib/rateLimitNative.ts` degrades gracefully: on any binding error (local
  // dev, non-CF runtime, transient API failure) the request falls back to the
  // in-process limiter instead of failing the request.
  "ratelimits":   [
    { "name": "RL_MUT10",  "namespace_id": "1001",  "simple": { "limit": 10,  "period": 60 } },
    { "name": "RL_MUT20",  "namespace_id": "1002",  "simple": { "limit": 20,  "period": 60 } },
    { "name": "RL_MUT30",  "namespace_id": "1003",  "simple": { "limit": 30,  "period": 60 } },
    { "name": "RL_MUT40",  "namespace_id": "1004",  "simple": { "limit": 40,  "period": 60 } },
    { "name": "RL_MUT60",  "namespace_id": "1005",  "simple": { "limit": 60,  "period": 60 } },
    { "name": "RL_MUT120", "namespace_id": "1006", "simple": { "limit": 120, "period": 60 } }
  ],
  // Public, build-time configuration.
  //
  // These are NEXT_PUBLIC_* values, which Next.js INLINES INTO THE CLIENT BUNDLE at
  // build time and ships to every browser — public by definition, so committing them
  // exposes nothing that is not already public.
  //
  // They live here rather than only in the Cloudflare dashboard because RUNTIME
  // variables are NOT visible to the build: on 2026-10-23 the Workers Builds pipeline
  // had 18 runtime prod vars configured, yet the build still logged "Supabase
  // environment variables are missing. Using placeholders for build." and deployed a
  // bundle with no CDP project id and no Supabase URL.
  //
  // Every NEXT_PUBLIC_* var the app reads must appear here. Missing ones fail
  // SILENTLY: chips balance and daily/weekly missions both vanished on 2026-10-23
  // because NEXT_PUBLIC_CHIPS_ADDRESS and NEXT_PUBLIC_MISSION_SYSTEM_ADDRESS were
  // absent — no contract address to read, no error, just empty UI. The leaderboard
  // kept working because it reads Supabase only.
  //
  // scripts/check-build-env.mjs writes these to .env.production before `next build`.
  // Secrets do NOT belong here — they stay in Worker secrets (cf-secrets.mjs).
  "vars":   {
    "NEXT_PUBLIC_SUPABASE_URL": "https://xvwaqxqyjtlsuijgwozi.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh2d2FxeHF5anRsc3Vpamd3b3ppIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk2NjIzOTgsImV4cCI6MjEwNTIzODM5OH0.meIJe2yyRv69d8NGqAGGilm04VZ7gR4wXQqO__LaYd4",
    "NEXT_PUBLIC_CDP_PROJECT_ID": "364b3239-e4ab-4d34-a7c4-81ec35003720",
    "NEXT_PUBLIC_CDP_AUTH": "1",
    "NEXT_PUBLIC_WC_PROJECT_ID": "673e0d259a5dc10d64b0fec83f6e8eca",
    "NEXT_PUBLIC_ONCHAINKIT_API_KEY": "YxhGPF4gkkpnfqWoNqrTDfqxUX1kKWdU",
    "NEXT_PUBLIC_EDGE_SERVER_URL": "wss://ludo-edge-server.onrender.com",
    "NEXT_PUBLIC_BUILDER_CODE": "bc_nao85n7u",
    "NEXT_PUBLIC_SENTRY_DSN": "https://37b16533b00dc5638f71670a3e19b28f@o4512138565255168.ingest.us.sentry.io/4512138573053952",
    "NEXT_PUBLIC_CHIPS_ADDRESS": "0xB200000000000000000000821408122b9Ed3d05B",
    "NEXT_PUBLIC_MATCH_POOL_ADDRESS": "0x4740048bdBAF5A5bbD37c7ce6dce666910993091",
    "NEXT_PUBLIC_MISSION_CLAIM_ADDRESS": "0x1A3371805ACff5eea1B1A5C9A231a7d9d78Cacd9",
    "NEXT_PUBLIC_LEGACY_CLAIM_ADDRESS": "0x6f9E12D5F9d81132214cdA8369410ab7c187227F",
    "NEXT_PUBLIC_CLAIM_HUB_ADDRESS": "0x15dF536466Ef58f77e95D7432089DeEBDf276821",
    "NEXT_PUBLIC_SEASON_CLAIM_ADDRESS": "0x1A27120eab8638e40ed8eEf60fAe13cC18277bd3",
    "NEXT_PUBLIC_WALLET_INGAME": "1",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BLKZUPgz1lB2ZFUv60t_BjJ7t5s2NY0kHAP4VbeF0CbMRz1u-ugyopRhIS76Z_0nFkFPNE7h_jAwidYxs07kvI4",
    "NEXT_PUBLIC_MISSION_SYSTEM_ADDRESS": "0xdfB78b0A8c1877156f00858c764CA72Ba4a6e2C6"
  },
  "routes":   [
    {
      "pattern": "play.ludobase.live",
      "custom_domain": true
    }
  ]
}
