{
  "$schema":   "node_modules/wrangler/config-schema.json",
  "main":   "src/worker.ts",
  "name":   "ludo-base",
  "compatibility_date":   "2025-01-01",
  "compatibility_flags":   [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets":   {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services":   [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ludo-base"
    }
  ],
  "durable_objects":   {
    "bindings": [
      {
        "name": "MATCH_ROOM",
        "class_name": "MatchRoom"
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimitDO"
      }
    ]
  },
  "migrations":   [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MatchRoom",
        "RateLimitDO"
      ]
    }
  ],
  "triggers":   {
    "crons": [
      "0 * * * *"
    ]
  },
  // Public, build-time configuration.
  //
  // These are NEXT_PUBLIC_* values, which Next.js INLINES INTO THE CLIENT BUNDLE at
  // build time and ships to every browser — public by definition, so committing them
  // exposes nothing that is not already public.
  //
  // They live here rather than only in the Cloudflare dashboard because RUNTIME
  // variables are NOT visible to the build: on 2026-10-23 the Workers Builds pipeline
  // had 18 runtime prod vars configured, yet the build still logged "Supabase
  // environment variables are missing. Using placeholders for build." and deployed a
  // bundle with no CDP project id and no Supabase URL. Declaring them here makes the
  // build self-sufficient — scripts/check-build-env.mjs injects this block into
  // process.env before `next build` runs.
  //
  // Secrets (SUPABASE_SERVICE_ROLE_KEY, CDP API secrets, ...) do NOT belong here —
  // they stay in Worker secrets via `wrangler secret put` / scripts/cf-secrets.mjs.
  "vars":   {
    "NEXT_PUBLIC_SUPABASE_URL": "https://xvwaqxqyjtlsuijgwozi.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh2d2FxeHF5anRsc3Vpamd3b3ppIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk2NjIzOTgsImV4cCI6MjEwNTIzODM5OH0.meIJe2yyRv69d8NGqAGGilm04VZ7gR4wXQqO__LaYd4",
    "NEXT_PUBLIC_CDP_PROJECT_ID": "364b3239-e4ab-4d34-a7c4-81ec35003720",
    "NEXT_PUBLIC_CDP_AUTH": "1",
    "NEXT_PUBLIC_WC_PROJECT_ID": "673e0d259a5dc10d64b0fec83f6e8eca",
    "NEXT_PUBLIC_ONCHAINKIT_API_KEY": "YxhGPF4gkkpnfqWoNqrTDfqxUX1kKWdU"
  },
  "routes":   [
    {
      "pattern": "play.ludobase.live",
      "custom_domain": true
    }
  ]
}
