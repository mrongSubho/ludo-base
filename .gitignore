# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# visual-diff harness — failure artifacts are transient; the baselines in
# tests/visual/baselines/ ARE committed (they are the reference).
/tests/visual/diffs/

# next.js
/.next/
/out/
.open-next/

# cloudflare workers (opennext adapter output + local-only vars)
.open-next/
.dev.vars
.wrangler/

# production
/build

# misc
.DS_Store
*.pem
.zcodeignore

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor extensions
*.vsix

# supabase CLI local temp
supabase/.temp/

# browser test traces (local only)
.playwright-cli/

# local design docs (not shipped)
design-system/

# local planning docs (not shipped)
.planning/

# agent skills (third-party, reproducible via `npx skills add` + skills-lock.json)
.agents/

# agent tool scaffolds (local-only)
.commandcode/
.agent/
.workbuddy-ai/
