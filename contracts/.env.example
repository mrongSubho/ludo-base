# Foundry / deploy env — copy to contracts/.env (never commit)
#
# IMPORTANT: Foundry loads this file and INLINE env vars both work, but a stale
# value here silently wins over an inline one for any key you leave set. After a
# real deploy, update the *_ADDRESS values below to what was just printed.

# ---------- RPC ----------
SEPOLIA_RPC=https://sepolia.base.org
BASE_RPC=https://mainnet.base.org

# ---------- verification ----------
# Keep the comment on its OWN line. Trailing "# ..." becomes part of the value
# and breaks --verify.
ETHERSCAN_API_KEY=

# ---------- deployer ----------
FOUNDRY_ACCOUNT=deployer

# The address the deploy key actually controls. RedeployPool.s.sol calls
# startBroadcast(DEPLOYER_ADDRESS) so a wrong value fails loudly instead of
# deploying from an unexpected account. A stale value here ALSO makes
# owner != deployer, which silently skips the setClaimHub wiring.
DEPLOYER_ADDRESS=

# ---------- contract wiring ----------
EDGE_SIGNER=
GAME_OWNER=
MISSION_OP_KEY=

# Real CHIPS token. Required by RedeployPool.s.sol, which reverts without it so
# a placeholder can never be broadcast by accident.
CHIPS_ADDRESS=0xB200000000000000000000821408122b9Ed3d05B

# DeployStack / DeployGame use this. NEVER let it stay true against BASE_RPC:
# USE_MOCK=true deploys a MockChips token and mints 1,000,000 CHIPS to the owner.
USE_MOCK=false

# ---------- read by scripts (no NEXT_PUBLIC_ prefix) ----------
MATCH_POOL_ADDRESS=
CLAIM_HUB_ADDRESS=
SEASON_CLAIM_ADDRESS=
MISSION_CLAIM_ADDRESS=

# ---------- read by the Next.js app ----------
NEXT_PUBLIC_MATCH_POOL_ADDRESS=
NEXT_PUBLIC_CLAIM_HUB_ADDRESS=
NEXT_PUBLIC_MISSION_CLAIM_ADDRESS=
NEXT_PUBLIC_SEASON_CLAIM_ADDRESS=
NEXT_PUBLIC_LEGACY_CLAIM_ADDRESS=
NEXT_PUBLIC_CHIPS_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# ---------- signing keys (never commit) ----------
MISSION_OP_PRIVATE_KEY=
EDGE_SETTLE_PRIVATE_KEY=