# CHIPS deploy env (copy to contracts/.env — never commit)

# Existing B20 token from CreateChips
CHIPS_ADDRESS=

# Edge settlement co-signer (threshold/HSM on Sepolia+mainnet before paid pools)
EDGE_SIGNER=
# Private key for the Edge co-signer (server/Edge only — never commit real keys)
# Used by /api/chips/lobby-ticket and /api/chips/settle/propose
EDGE_SETTLE_PRIVATE_KEY=
# MatchPool address (also NEXT_PUBLIC_MATCH_POOL_ADDRESS for the client)
MATCH_POOL_ADDRESS=
NEXT_PUBLIC_MATCH_POOL_ADDRESS=
NEXT_PUBLIC_CHIPS_ADDRESS=

# MissionClaim voucher op-key
MISSION_OP_KEY=

# Multisig that owns MatchPool / ClaimHub / MissionClaim admin
GAME_OWNER_MULTISIG=

# B20 bootstrap (CreateChips)
CHIPS_ADMIN_MULTISIG=
SEASON_DISTRIBUTOR=
MARKETPLACE=
SECURITY_MULTISIG=
OPS_MULTISIG=

# RPC (dedicated/self-hosted — never public in prod)
SEPOLIA_RPC=
ETHERSCAN_API_KEY=
