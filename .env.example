# Ludo Base client env (copy to .env.local — never commit secrets)

# Sentry (un-park item 3) — create project at sentry.io, paste DSN
NEXT_PUBLIC_SENTRY_DSN=

# WalletConnect (already used)
NEXT_PUBLIC_WC_PROJECT_ID=

# CDP non-custodial wallets (Phase 0a spike — SMART_WALLET_PLAN)
# Project ID from https://portal.cdp.coinbase.com (never commit the real id)
NEXT_PUBLIC_CDP_PROJECT_ID=
# Mount CDPHooksProvider beside wagmi during the 0a spike (0/1). No connect cutover.
NEXT_PUBLIC_CDP_AUTH=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Edge / match
NEXT_PUBLIC_EDGE_SERVER_URL=

# PeerJS signaling (N0) — empty = peerjs.com cloud; set for self-hosted PeerServer
# NEXT_PUBLIC_PEERJS_HOST=peer.example.com
# NEXT_PUBLIC_PEERJS_PORT=443
# NEXT_PUBLIC_PEERJS_PATH=/ludo
# NEXT_PUBLIC_PEERJS_KEY=ludo
# NEXT_PUBLIC_PEERJS_SECURE=1

# CHIPS (optional until Phase-1 value)
NEXT_PUBLIC_MATCH_POOL_ADDRESS=
NEXT_PUBLIC_CHIPS_ADDRESS=

# Show Create in-game wallet CTA (CDP Mode B)
NEXT_PUBLIC_WALLET_INGAME=1

# Web Push (R5 remote push) — generate with: npx web-push generate-vapid-keys
# Public key is safe in the client bundle; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@ludo.base

# Etherscan V2 (Base Sepolia activity). Server-only — never NEXT_PUBLIC_
ETHERSCAN_API_KEY=
